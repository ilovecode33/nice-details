{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilovecode33-okr-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      }
    ]
  },
  "exports": {
    "SyncRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
