  "glass": {
    "light": {
      "fill": "rgba(255,255,255,0.52)",
      "stroke": "rgba(255,255,255,0.82)",
      "highlight": "rgba(255,255,255,0.92)",
      "shadow": "0 8px 32px rgba(15,23,42,0.16)"
    },
    "dark": {
      "fill": "rgba(24,26,34,0.52)",
      "stroke": "rgba(255,255,255,0.14)",
      "highlight": "rgba(255,255,255,0.24)",
      "shadow": "0 10px 36px rgba(0,0,0,0.48)"
    }
  },
  "glassMetrics": {
    "blur": "20px",
    "saturate": "180%"
  },
  "spacing": {
    "s1": "4px",
    "s2": "8px",
    "s3": "12px",
    "s4": "16px",
    "s5": "20px",
    "s6": "24px",
    "s8": "32px"
  },
  "radii": {
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "pill": "999px"
  },
  "typography": {
    "font": "'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif",
    "fontMono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "xs": "11px",
    "sm": "12.5px",
    "base": "14px",
    "lg": "17px",
    "xl": "22px"
  },
  "motion": {
    "ease": "cubic-bezier(0.32, 0.72, 0, 1)",
    "duration": "0.2s",
    "deformShift": "18px",
    "deformStretch": "10px",
    "deformSquash": "5px",
    "deformScale": "0.96",
    "springDuration": "0.22s",
    "springEase": "cubic-bezier(0.16, 1.45, 0.3, 1)",
    "morphDuration": "0.26s",
    "morphEase": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "touch": "44px",
  "safeArea": {
    "top": "env(safe-area-inset-top, 0px)",
    "bottom": "env(safe-area-inset-bottom, 0px)",
    "left": "env(safe-area-inset-left, 0px)",
    "right": "env(safe-area-inset-right, 0px)"
  },
  "derived": {
    "bgGradient": "radial-gradient(1100px 700px at 12% -12%, var(--accent-tint), transparent 60%), radial-gradient(900px 620px at 92% -4%, var(--accent-tint), transparent 55%)",
    "iconSm": "16px",
    "iconMd": "20px",
    "iconLg": "24px",
    "zPortal": "1000",
    "dockScrollDuration": "0.24s",
    "glowDuration": "0.6s",
    "glowEase": "ease-out",
    "glowSize": "190%",
    "glowPeak": "0.65",
    "glowSpecular": "#ffffff",
    "segThumbFill": "color-mix(in srgb, var(--accent) 34%, transparent)",
    "segThumbSolid": "color-mix(in srgb, var(--accent) 55%, var(--bg-elevated))",
    "segThumbStroke": "var(--glass-highlight)",
    "segThumbInk": "var(--text)",
    "segThumbGlow": "var(--accent-glow)",
    "segThumbHalo": "color-mix(in srgb, var(--accent) 45%, var(--glass-highlight))",
    "btnGlow": "color-mix(in srgb, var(--accent) 60%, transparent)",
    "btnGlowSoft": "color-mix(in srgb, var(--accent) 32%, transparent)",
    "btnDangerStroke": "var(--glass-highlight)",
    "btnDangerGlow": "color-mix(in srgb, var(--danger) 60%, transparent)",
    "btnDangerGlowSoft": "color-mix(in srgb, var(--danger) 32%, transparent)",
    "glassBackdrop": "blur(var(--glass-blur)) saturate(var(--glass-saturate))"
  },
  "derivedLight": {
    "segThumbStroke": "color-mix(in srgb, var(--accent) 55%, transparent)",
    "btnDangerStroke": "color-mix(in srgb, var(--danger) 55%, transparent)"
  }
}
