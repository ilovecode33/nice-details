{
  "name": "@ilovecode33/ui-tokens",
  "version": "0.3.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./generated/styles.css"
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch --no-dts --no-clean",
    "typecheck": "tsc --noEmit",
    "generate": "bun scripts/generate.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@rslib/core": "^1.1.0",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
