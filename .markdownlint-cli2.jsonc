{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md", ".changeset/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.wrangler/**"
  ],
  "overrides": [
    {
      "filter": [".changeset/*.md"],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    },
    {
      "filter": ["**/CHANGELOG.md"],
      "config": {
        "MD033": false
      },
      "combine": "merge"
    }
  ]
}
