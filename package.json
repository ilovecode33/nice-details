{
  "name": "@ilovecode33/nice-details",
  "version": "0.0.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:md": "prettier --write \"**/*.md\" \".changeset/*.md\"",
    "lint:md": "markdownlint-cli2",
    "check:md": "prettier --check \"**/*.md\" \".changeset/*.md\" && bun run lint:md",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "check:changesets": "changeset status --since=origin/main",
    "clean": "turbo run clean",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
